# Accurit - Variáveis de ambiente de exemplo
# Copie este arquivo para .env e preencha os valores adequados

# Ambiente
APP_ENV=production

# Banco de Dados
POSTGRES_USER=accurit
POSTGRES_PASSWORD=change_me
POSTGRES_APP_USER=accurit_app
POSTGRES_APP_PASSWORD=change_me
POSTGRES_DB=accurit

DATABASE_URL=postgres://accurit_app:change_me@postgres:5432/accurit
TEST_DATABASE_ADMIN_URL=postgres://accurit:change_me@postgres:5432/accurit

# Segurança
JWT_SECRET=change_me_minimum_32_chars
CERTIFICATE_MASTER_KEY=change_me_minimum_32_chars

# SERPRO
SERPRO_TOKEN_URL=https://gateway.apiserpro.serpro.gov.br/token
SERPRO_SAPI_AUTH_URL=https://autenticacao.sapi.serpro.gov.br/authenticate
SERPRO_INTEGRA_TRIAL_URL=https://gateway.apiserpro.serpro.gov.br/integra-contador-trial/v1
SERPRO_DIVIDA_ATIVA_TRIAL_URL=https://gateway.apiserpro.serpro.gov.br/consulta-divida-ativa-trial/api/v1
SERPRO_INTEGRA_PROD_URL=https://gateway.apiserpro.serpro.gov.br/integra-contador/v1
SERPRO_DIVIDA_ATIVA_PROD_URL=
SERPRO_TRIAL_BEARER_TOKEN=
# Simulador determinístico em TRIAL. Padrão: true quando o bearer token acima
# está ausente; false quando ele está presente. Nunca é usado em produção.
SERPRO_TRIAL_MOCK=true
SERPRO_CONSUMER_KEY=
SERPRO_CONSUMER_SECRET=
SERPRO_OPERATOR_HEADER_ENABLED=true

# Timeouts
SERPRO_HTTP_CONNECT_TIMEOUT_SECS=5
SERPRO_HTTP_REQUEST_TIMEOUT_SECS=30
SERPRO_PROCURACAO_CACHE_TTL_SECS=300

# Aplicação
AUTH_ACCESS_TTL_SECS=900
AUTH_REFRESH_TTL_ADMIN_SECS=28800
AUTH_REFRESH_TTL_CLIENT_SECS=604800
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_COOKIE_SECURE=true

# Divida Ativa fallback
DIVIDA_ATIVA_FALLBACK_CODIGO_CONTRIBUINTE=false

# Job runner (Fase B.1) — worker interno de trabalhos agendados e lotes.
# Desligue com JOBS_RUNNER_ENABLED=false (ex.: durante migrações manuais).
JOBS_RUNNER_ENABLED=true
JOBS_POLL_INTERVAL_SECS=60
JOBS_MAX_CONCORRENCIA=4
JOBS_LEASE_SECS=120
JOBS_BACKOFF_BASE_SECS=30
JOBS_BACKOFF_TETO_SECS=3600
JOBS_MAX_TENTATIVAS=5

# Token Bearer para GET /api/v1/metrics (Prometheus). Sem ele, a rota responde 403.
METRICS_TOKEN=
