# Copy this file to .env and replace every placeholder before running
# `docker compose up --build`. Never commit the real .env.
#
# Prefer `scripts/init-env.sh` (or `scripts/init-env.ps1`) to generate .env
# with random passwords and secrets. The placeholders below are rejected by
# the backend on purpose.

APP_ENV=development
HTTP_PORT=80

# --- PostgreSQL ---
# POSTGRES_USER is the container superuser and is used only for administration
# and tests. DATABASE_URL must use the non-superuser application role.
# URL-encode special characters in the password if you set them manually.
POSTGRES_USER=accurit
POSTGRES_PASSWORD=change-me
POSTGRES_APP_USER=accurit_app
POSTGRES_APP_PASSWORD=change-me-app
POSTGRES_DB=accurit
DATABASE_URL=postgres://accurit_app:change-me-app@postgres:5432/accurit

# Superuser connection used only by the `tools` profile. Required by
# `backend-test`; `schema-tool` builds its own admin connection from POSTGRES_*.
TEST_DATABASE_ADMIN_URL=postgres://accurit:change-me@postgres:5432/accurit

# --- Backend security ---
# Generate with: openssl rand -base64 48 (must decode to at least 32 bytes)
JWT_SECRET=change-me
# 32 raw bytes for AES-256-GCM (e.g. `openssl rand -base64 32`). The
# placeholder below is invalid on purpose and must fail at startup.
CERTIFICATE_MASTER_KEY=change-me-32-bytes

# Comma-separated list of browser origins allowed to call the API directly.
# Empty means no cross-origin access; the normal flow is same-origin via the
# Nginx proxy. In development you may use http://localhost:4200.
CORS_ALLOWED_ORIGINS=

RUST_LOG=info

# --- Autenticação (Fase 2A) ---
# Sessão: access token (JWT HS256) e refresh token opaco por audiência.
AUTH_ACCESS_TTL_SECS=900
AUTH_REFRESH_TTL_ADMIN_SECS=28800
AUTH_REFRESH_TTL_CLIENT_SECS=604800
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_SECS=900
# `false` só é aceito com APP_ENV=development (HTTP local). Em produção use
# `true` para que o cookie de refresh só trafegue em HTTPS.
AUTH_COOKIE_SECURE=false
# Ajuste opcional do Argon2id; os padrões abaixo seguem a recomendação OWASP.
# AUTH_ARGON2_MEMORY_KIB=19456
# AUTH_ARGON2_ITERATIONS=2
# AUTH_ARGON2_PARALLELISM=1

# --- SERPRO ---
SERPRO_TOKEN_URL=https://gateway.apiserpro.serpro.gov.br/token
SERPRO_SAPI_AUTH_URL=https://autenticacao.sapi.serpro.gov.br/authenticate
SERPRO_INTEGRA_PROD_URL=https://gateway.apiserpro.serpro.gov.br/integra-contador/v1
SERPRO_DIVIDA_ATIVA_PROD_URL=https://gateway.apiserpro.serpro.gov.br/consulta-divida-ativa/api/v1

# --- SERPRO TRIAL---
SERPRO_INTEGRA_TRIAL_URL=https://gateway.apiserpro.serpro.gov.br/integra-contador-trial/v1
SERPRO_DIVIDA_ATIVA_TRIAL_URL=https://gateway.apiserpro.serpro.gov.br/consulta-divida-ativa-trial/api/v1
SERPRO_TRIAL_BEARER_TOKEN=Bearer 06aef429-a981-3ec5-a1f8-71d38d86481e

# Global fallback for development only. Production uses credenciais_serpro.
SERPRO_CONSUMER_KEY=
SERPRO_CONSUMER_SECRET=

# Operational header not confirmed by official docs (D3).
SERPRO_OPERATOR_HEADER_ENABLED=true
# Unconfirmed fallback; keep disabled unless explicitly validated (D2).
DIVIDA_ATIVA_FALLBACK_CODIGO_CONTRIBUINTE=false
SERPRO_HTTP_CONNECT_TIMEOUT_SECS=5
SERPRO_HTTP_REQUEST_TIMEOUT_SECS=30
SERPRO_PROCURACAO_CACHE_TTL_SECS=300
