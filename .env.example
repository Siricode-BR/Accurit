# Copy this file to .env and replace every placeholder before running
# `docker compose up --build`. Never commit the real .env.

APP_ENV=development
HTTP_PORT=80

# --- PostgreSQL ---
# DATABASE_URL must use the same credentials as POSTGRES_* and the `postgres`
# service hostname. URL-encode special characters in the password.
POSTGRES_USER=accurit
POSTGRES_PASSWORD=change-me
POSTGRES_DB=accurit
DATABASE_URL=postgres://accurit:change-me@postgres:5432/accurit

# --- Backend security ---
# Generate with: openssl rand -base64 48
JWT_SECRET=change-me
# 32 raw bytes for AES-256-GCM (e.g. `openssl rand -base64 32`). The
# placeholder below is invalid on purpose and must fail at startup.
CERTIFICATE_MASTER_KEY=change-me-32-bytes

RUST_LOG=info

# --- SERPRO ---
SERPRO_TOKEN_URL=https://gateway.apiserpro.serpro.gov.br/token
SERPRO_SAPI_AUTH_URL=https://autenticacao.sapi.serpro.gov.br/authenticate
SERPRO_INTEGRA_TRIAL_URL=https://gateway.apiserpro.serpro.gov.br/integra-contador-trial/v1
SERPRO_DIVIDA_ATIVA_TRIAL_URL=https://gateway.apiserpro.serpro.gov.br/consulta-divida-ativa-trial/api/v1
SERPRO_INTEGRA_PROD_URL=https://gateway.apiserpro.serpro.gov.br/integra-contador/v1
# Leave empty until SERPRO confirms the production URL (D5).
SERPRO_DIVIDA_ATIVA_PROD_URL=
SERPRO_TRIAL_BEARER_TOKEN=
# Global fallback for development only. Production uses credenciais_serpro.
SERPRO_CONSUMER_KEY=
SERPRO_CONSUMER_SECRET=

# Operational header not confirmed by official docs (D3).
SERPRO_OPERATOR_HEADER_ENABLED=true
# Unconfirmed fallback; keep disabled unless explicitly validated (D2).
DIVIDA_ATIVA_FALLBACK_CODIGO_CONTRIBUINTE=false
SERPRO_HTTP_CONNECT_TIMEOUT_SECS=5
SERPRO_HTTP_REQUEST_TIMEOUT_SECS=30
SERPRO_PROCURACAO_CACHE_TTL_SECS=300
